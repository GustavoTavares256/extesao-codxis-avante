{
  "manifest_version": 3,
  "name": "Avante Web Dashboard",
  "version": "1.0.0",
  "description": "Dashboard moderno injetado automaticamente no sistema Avante Web sem alterar o código-fonte do sistema.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Avante Web Dashboard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["api.js", "dashboard.js", "style.css"],
      "matches": ["https://*/*"]
    }
  ]
}
